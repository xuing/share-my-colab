# share-my-colab server configuration template
# Copy to .env (which is gitignored) and adjust as needed before starting server.py.

# Listen address and port.
# Keep 127.0.0.1 when terminating TLS with a local reverse proxy (e.g. Caddy/Nginx).
COLAB_GW_HOST=127.0.0.1
COLAB_GW_PORT=8790

# Bearer token used by clients and the Web UI.
# Leave commented out to let server.py auto-generate .gateway_token (chmod 0600) on first launch.
# COLAB_GW_TOKEN=cgw_replace_with_your_secret_token

# Sandbox mode: auto | bwrap | off
# "bwrap" (recommended in production) fails closed if bubblewrap is unavailable.
COLAB_GW_SANDBOX=bwrap

# Job timeouts (seconds) and concurrency limit
COLAB_GW_DEFAULT_TIMEOUT=600
COLAB_GW_MAX_TIMEOUT=3600
COLAB_GW_MAX_CONCURRENT=4

# Grace period (seconds) after SIGINT before SIGTERM/SIGKILL on timeout or shutdown
COLAB_GW_KILL_GRACE=30

# Size limits (bytes)
# 64 MiB max JSON request body (includes base64-encoded uploaded files)
COLAB_GW_MAX_BODY_BYTES=67108864
# 64 MiB max total returned files per job
COLAB_GW_MAX_RETURN_BYTES=67108864
# 4 MiB max retained stdout / stderr per stream (head + tail)
COLAB_GW_MAX_OUTPUT_BYTES=4194304
# 1024 MiB (1 GiB) max per-job temporary working directory size
COLAB_GW_MAX_WORKDIR_BYTES=1073741824

# Optional overrides if `colab` or its Python interpreter is not on PATH
# COLAB_BIN=/home/colab/.local/bin/colab
# COLAB_PYTHON=/home/colab/.local/share/uv/tools/google-colab-cli/bin/python
